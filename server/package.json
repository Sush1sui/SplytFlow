{
  "name": "server-v2",
  "version": "1.0.50",
  "scripts": {
    "test": "bun run test:unit",
    "test:unit": "bun test src/tests/unit/**/*.test.ts --timeout 10000",
    "test:unit:endpoints": "bun test src/tests/unit/endpoints/**/*.test.ts --timeout 10000",
    "test:unit:auth": "bun test src/tests/unit/auth/**/*.test.ts --timeout 10000",
    "dev": "bun run --watch src/index.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:stamp": "bun run scripts/db-stamp.ts",
    "db:reset:domain": "bun run scripts/db-reset-domain.ts",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "cloudinary": "^2.9.0",
    "drizzle-orm": "^0.45.1",
    "elysia": "latest",
    "jose": "^6.1.3",
    "nodemailer": "^8.0.1",
    "pg": "^8.13.3"
  },
  "devDependencies": {
    "bun-types": "latest",
    "drizzle-kit": "^0.31.9"
  },
  "module": "src/index.js"
}
